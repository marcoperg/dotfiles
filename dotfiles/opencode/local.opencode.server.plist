<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.opencode.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>mkdir -p "$HOME/Library/Logs/OpenCode" &amp;&amp; cd "$HOME" &amp;&amp; exec "$HOME/.opencode/bin/opencode" web --hostname 127.0.0.1 --port 4096 &gt;&gt;"$HOME/Library/Logs/OpenCode/server.log" 2&gt;&gt;"$HOME/Library/Logs/OpenCode/server-error.log"</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

</dict>
</plist>
