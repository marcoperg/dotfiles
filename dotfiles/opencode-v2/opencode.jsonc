{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "skills": [
    "~/clip/Systems/ciao-skills/skills",
    "~/knowledge/praxis/skills",
    "~/.local/share/isabelle-dev/isabelle-pide-mcp/.opencode/skills",
    "~/dotfiles/dotfiles/isabelle/skills"
  ],
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "knowledge-ecosystem", "effect": "ask" }
  ],
  "mcp": {
    "servers": {
      "isabelle": {
        "type": "local",
        "command": ["{env:HOME}/dotfiles/dotfiles/bin/isabelle-dev", "mcp"],
        "codemode": false,
        "timeout": { "startup": 120000 }
      },
      "ciao": {
        "type": "local",
        "command": [
          "node",
          "{env:HOME}/clip/Systems/ciao-mcp/src/server.mjs"
        ],
        "environment": {
          "CIAOSH": "{env:HOME}/clip/Systems/ciao-devel/build/bin/ciaosh"
        },
        "codemode": false
      }
    }
  }
}
