# Default values (can be overridden by account blocks)
defaults
auth           on
tls            on
tls_certcheck  on
tls_trust_file system
logfile        ~/.msmtp.log

# Account UPM
account      upm
host         smtp.upm.es
port         587
from         marco.perez@alumnos.upm.es
user         marco.perez@alumnos.upm.es
auth         on
tls          on
tls_starttls on
passwordeval gpg --no-tty -qd ~/.authinfo.gpg | awk '/machine correo.alumnos.upm.es/ {print $6; exit}' | tr -d '\"'

# The retired @imdea.org account can no longer send mail.
# Account IMDEA Software
account      imdea
host         mail.software.imdea.org
port         587
from         marco.perez@software.imdea.org
user         marco.perez@software.imdea.org
auth         on
tls          on
tls_starttls on
passwordeval gpg --no-tty -qd ~/.authinfo.gpg | awk '/machine mail[.]software[.]imdea[.]org/ {print $6; exit}' | tr -d '\"'

# Account Google
account gmail
host smtp.gmail.com
port 587
from marcopg4@gmail.com
user marcopg4@gmail.com
tls          on
tls_starttls on
passwordeval gpg --no-tty -qd ~/.authinfo.gpg | awk '/machine smtp.gmail.com/ {print $6; exit}' | tr -d '\"'

