;;; test_isabelle.el --- Isabelle editor regression tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'package)
(package-initialize)
(require 'quail)
(require 'autorevert)

(defvar my/isabelle-auto-start nil)
(defconst my/test-quail-start (symbol-function 'quail-start-translation))
(defconst my/test-process-start (symbol-function 'start-file-process-shell-command))
(defconst my/test-quail-default (default-value 'quail-current-package))
(defconst my/test-default-input default-input-method)
(defconst my/test-root
  (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(load (expand-file-name "dotfiles/emacs/my-isabelle.el" my/test-root) nil t)

(ert-deftest my/isabelle-no-global-overrides ()
  (should (eq my/test-quail-start (symbol-function 'quail-start-translation)))
  (should (eq my/test-process-start (symbol-function 'start-file-process-shell-command)))
  (should (eq my/test-quail-default (default-value 'quail-current-package)))
  (should (equal my/test-default-input default-input-method))
  (should-not (bound-and-true-p evil-mode)))

(ert-deftest my/isabelle-missing-installation-is-actionable ()
  (let ((my/isabelle-profile '((isar_mode_home . "/missing-isabelle-test-checkout"))))
    (let ((error (should-error (my/isabelle-check-installation) :type 'user-error)))
      (should (string-match-p "setup.py.*--install" (error-message-string error))))))

(ert-deftest my/isabelle-spanish-input-isolation ()
  (with-temp-buffer
    (activate-input-method "spanish-prefix")
    ;; Quail normalizes a rule on first lookup; snapshot after that cache fill.
    (quail-lookup-key "'a")
    (let ((map (copy-tree (quail-map)))
          (keys (copy-tree (quail-translation-keymap)))
          (default default-input-method))
      (isar-mode)
      (should (equal current-input-method "spanish-prefix"))
      (should (equal map (quail-map)))
      (should (equal keys (quail-translation-keymap)))
      (should (equal default default-input-method))
      (should (equal (car (quail-lookup-key "'a")) 225))
      (unicode-tokens-mode -1)
      (should (equal current-input-method "spanish-prefix"))
      (unicode-tokens-mode 1)
      (should (equal current-input-method "spanish-prefix"))
      (activate-input-method "Unicode tokens")
      (should (equal (cdr (car (quail-lookup-key "\\times"))) ["\\<times>"]))
      (activate-input-method "spanish-prefix")
      (should (equal map (quail-map)))))
  (with-temp-buffer
    (activate-input-method "spanish-prefix")
    (should (equal (car (quail-lookup-key "~n")) 241))))

(ert-deftest my/isabelle-standard-bindings-and-display ()
  (with-temp-buffer
    (isar-mode)
    (should (eq (key-binding (kbd "C-x s")) 'save-some-buffers))
    (should (commandp (key-binding (kbd "C-c C-l"))))
    (should (eq (key-binding (kbd "C-c C-h")) 'lsp-isar-sledgehammer-interface))
    (insert "lemma foo: \"A \\<times>B\"")
    (font-lock-ensure)
    (goto-char (point-min))
    (search-forward "\\<times>")
    (should (get-text-property (- (point) 8) 'composition))))

(ert-deftest my/isabelle-menu-is-mode-local ()
  (with-temp-buffer
    (isar-mode)
    (should (keymapp (lookup-key isar-mode-map [menu-bar Isabelle])))
    (should (eq (key-binding (kbd "C-x s")) 'save-some-buffers)))
  (with-temp-buffer
    (fundamental-mode)
    (should-not (lookup-key (current-global-map) [menu-bar Isabelle]))))

(ert-deftest my/isabelle-single-save ()
  (let ((file (make-temp-file "isabelle-save-" nil ".thy")))
    (unwind-protect
        (with-current-buffer (find-file-noselect file)
          (insert "theory Save imports Main begin\ntext ‹á ∀ ×›\nend\n")
          (save-buffer)
          (should-not (buffer-modified-p))
          (let ((saved (buffer-substring-no-properties (point-min) (point-max))))
            (should (string-match-p (regexp-quote "\\<times>") saved))
            (should (string-match-p "á" saved))
            (should (equal saved (with-temp-buffer (insert-file-contents file)
                                                 (buffer-string)))))
          (kill-buffer))
      (delete-file file))))

(ert-deftest my/isabelle-external-reload-preserves-unsaved-edits ()
  (let ((file (make-temp-file "isabelle-reload-" nil ".thy")))
    (unwind-protect
        (with-current-buffer (find-file-noselect file)
          (should auto-revert-mode)
          (with-temp-file file (insert "external update\n"))
          (setq auto-revert-notify-modified-p t)
          (auto-revert-handler)
          (should (equal (buffer-string) "external update\n"))
          (should-not (buffer-modified-p))
          (insert "unsaved edit\n")
          (with-temp-file file (insert "second external update\n"))
          (setq auto-revert-notify-modified-p t)
          (auto-revert-handler)
          (should (string-match-p "unsaved edit" (buffer-string)))
          (should (buffer-modified-p))
          (set-buffer-modified-p nil)
          (kill-buffer))
      (delete-file file))))

(ert-deftest my/isabelle-real-file-notification ()
  (let ((file (make-temp-file "isabelle-notify-" nil ".thy")))
    (unwind-protect
        (with-current-buffer (find-file-noselect file)
          (with-temp-file file (insert "external notification\n"))
          (let ((deadline (+ (float-time) 10)))
            (while (and (not (equal (buffer-string) "external notification\n"))
                        (< (float-time) deadline))
              ;; Native notifications are special keyboard events, not process
              ;; output.  Exercise the same dispatch as the interactive loop.
              (let ((event (read-event nil nil 0.1)))
                (when (eq (car-safe event) 'file-notify)
                  (file-notify-handle-event event)))))
          (should (equal (buffer-string) "external notification\n"))
          (should-not (buffer-modified-p))
          (kill-buffer))
      (delete-file file))))

